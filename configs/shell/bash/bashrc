# GarudaRice bash defaults
[[ $- != *i* ]] && return

command -v starship >/dev/null 2>&1 && eval "$(starship init bash)"

if command -v eza >/dev/null 2>&1; then
  alias ls='eza -al --group-directories-first'
  alias la='eza -a --group-directories-first'
  alias ll='eza -l --group-directories-first'
  alias lt='eza -aT --group-directories-first'
  alias l.='eza -ald --group-directories-first .*'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat --style header --style snip --style changes --style header'

alias ..='cd ..' ...='cd ../..' ....='cd ../../..'
alias dir='dir --color=auto' vdir='vdir --color=auto'
alias ip='ip -color' please='sudo' wget='wget -c '
alias jctl='journalctl -p 3 -xb'
command -v ugrep >/dev/null 2>&1 && alias grep='ugrep --color=auto' || alias grep='grep --color=auto'

_RICE=""
for d in /usr/local/share/garuda-rice /usr/share/garuda-rice "${HOME}/.local/share/garuda-rice"; do
  [[ -d "$d/distro" ]] && { _RICE="$d"; break; }
done
_FAM="$(cat "${_RICE}/distro/current" 2>/dev/null || echo arch)"
case "$_FAM" in
  fedora)
    alias upd='sudo dnf upgrade --refresh'
    alias cleanup='sudo dnf autoremove'
    alias rmpkg='sudo dnf remove'
    ;;
  debian)
    alias upd='sudo apt update && sudo apt upgrade'
    alias cleanup='sudo apt autoremove --purge'
    alias rmpkg='sudo apt remove'
    ;;
  *)
    alias upd='sudo pacman -Syu'
    alias fixpacman='sudo rm -f /var/lib/pacman/db.lck'
    alias rmpkg='sudo pacman -Rdd'
    alias cleanup='sudo pacman -Rns $(pacman -Qtdq) 2>/dev/null'
    [[ -x /usr/bin/paru && ! -x /usr/bin/yay ]] && alias yay='paru'
    ;;
esac
unset _RICE _FAM

__garuda_rice_fastfetch() {
  command -v fastfetch >/dev/null 2>&1 || return 0
  local p
  for p in /usr/local/share/fastfetch/presets/dr460nized.jsonc \
           /usr/share/fastfetch/presets/dr460nized.jsonc \
           "${HOME}/.local/share/fastfetch/presets/dr460nized.jsonc"; do
    [[ -f "$p" ]] && { fastfetch --config "$p"; return; }
  done
  fastfetch
}
